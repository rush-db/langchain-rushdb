{
  "name": "@rushdb/langchain",
  "version": "0.1.0",
  "description": "LangChain and LangGraph integration for RushDB: vector store, hybrid retriever, long-term memory store and checkpointer, on RushDB Cloud or self-hosted",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rush-db/langchain-rushdb.git",
    "directory": "libs/js"
  },
  "homepage": "https://docs.rushdb.com/integrations/langchain",
  "keywords": [
    "rushdb",
    "langchain",
    "langgraph",
    "vector store",
    "hybrid search",
    "checkpointer",
    "agent memory",
    "rag",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@rushdb/javascript-sdk": "^3.3.0"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph-checkpoint": "^1.0.0"
  },
  "devDependencies": {
    "@langchain/core": "1.3.5",
    "@langchain/langgraph": "1.7.2",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "@langchain/langgraph-checkpoint-validation": "1.2.0",
    "@types/node": "^20.19.43",
    "rimraf": "^6.1.4",
    "typescript": "5.7.2",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
